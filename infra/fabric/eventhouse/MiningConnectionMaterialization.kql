// Queued, nontransactional materialization only. The raw append must survive
// classifier/policy failures; callers can replay it after repairing metadata.
// The classifier joins versioned binding and run-profile tables, so do not
// enable streaming ingestion on any of its upstream tables.
.alter table mining_ValidatedConnectionMeasurement policy update @'[{"IsEnabled":true,"Source":"mining_ConnectionMeasurementRaw","Query":"mining_ClassifyConnectionMeasurementV1() | where disposition == \"ACCEPTED\" | project plant_id,run_id,event_id,sequence,sample_time=event_time,received_at,stream_id,measurement_tag_id,source_module_id,source_port_id,source_equipment_id,source_equipment_port_id,target_module_id,target_port_id,target_equipment_id,target_equipment_port_id,quantity,basis,value,unit,quality,origin,schema_version,sample_interval_seconds,catalog_version,measurement_catalog_version,profile_version,payload_fingerprint","IsTransactional":false,"PropagateIngestionProperties":false}]'

.alter table mining_ConnectionQuarantine policy update @'[{"IsEnabled":true,"Source":"mining_ConnectionMeasurementRaw","Query":"mining_ClassifyConnectionMeasurementV1() | where disposition == \"QUARANTINED\" | project source_kind=\"connection_measurement\",received_at,raw_event,sample_time_raw,plant_id,run_id,event_id,sequence,disposition,reason_codes,catalog_version,measurement_catalog_version,profile_version,payload_fingerprint","IsTransactional":false,"PropagateIngestionProperties":false}]'

// No policy is attached to BLOCKED results (for example, a missing profile
// seed). They remain queryable in raw and can be reclassified after setup.
