model Model
    culture: en-US
    defaultPowerBIDataSourceVersion: powerBI_V3
    sourceQueryCulture: en-US
    dataAccessOptions
        legacyRedirects
        returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DirectLake - TriathlonTrainingTwinLakehouse"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DirectLakeOnOneLakeInWeb", "WebModelingEdit"]

ref table TrainingSession
ref table RecoveryMetrics
ref table SleepSession
ref table NutritionLog
ref table TrainingBlock
ref table TrainingBlockPhase
ref table Race
