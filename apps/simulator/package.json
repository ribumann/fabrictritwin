{
  "name": "@triathlon-twin/simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Daily generation job + on-demand live session/race generator for the Triathlon Training Twin demo",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mining": {
      "types": "./dist/mining/index.d.ts",
      "default": "./dist/mining/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "@azure/storage-file-datalake": "^12.29.0",
    "@azure/identity": "^4.13.2",
    "@azure/event-hubs": "^6.0.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "license": "MIT"
}
