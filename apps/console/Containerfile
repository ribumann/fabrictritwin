FROM node:24-alpine@sha256:a34ab6d7f6f4813f4d0c5469d74685604b962fbdbf5793a7bc7b4998ecb867c8 AS build

WORKDIR /workspace

COPY package.json package-lock.json ./
COPY apps/console/package.json apps/console/package.json
COPY apps/streaming-backend/package.json apps/streaming-backend/package.json
COPY apps/mcp-tools/package.json apps/mcp-tools/package.json
COPY apps/cockpit/package.json apps/cockpit/package.json
COPY apps/simulator/package.json apps/simulator/package.json

RUN npm ci --no-audit --no-fund

COPY . .

# console now has a REAL runtime dependency on @triathlon-twin/simulator (deriveGoalRaceId,
# used by src/actions/default-race-id.ts to pre-fill the "Trigger Race" prompt -- not just
# types), resolved via the "file:../simulator" workspace link whose package.json points
# "main"/"types" at dist/index.js|d.ts. That dist/ only exists once simulator itself has been
# compiled, so it must be built here too (before/alongside console) or both tsc (missing type
# declarations) and the running container (missing module at import time) fail.
RUN npm run build --workspace apps/simulator --workspace apps/console

FROM node:24-alpine@sha256:a34ab6d7f6f4813f4d0c5469d74685604b962fbdbf5793a7bc7b4998ecb867c8 AS prod-deps

WORKDIR /workspace

COPY package.json package-lock.json ./
COPY apps/console/package.json apps/console/package.json
COPY apps/streaming-backend/package.json apps/streaming-backend/package.json
COPY apps/mcp-tools/package.json apps/mcp-tools/package.json
COPY apps/cockpit/package.json apps/cockpit/package.json
COPY apps/simulator/package.json apps/simulator/package.json

RUN npm ci --omit=dev --workspace apps/simulator --workspace apps/console --include-workspace-root=false --no-audit --no-fund

FROM node:24-alpine@sha256:a34ab6d7f6f4813f4d0c5469d74685604b962fbdbf5793a7bc7b4998ecb867c8 AS runtime

ENV NODE_ENV=production \
    PORT=3200

WORKDIR /workspace

COPY --from=prod-deps --chown=node:node /workspace/package.json /workspace/package.json
COPY --from=prod-deps --chown=node:node /workspace/node_modules /workspace/node_modules
COPY --from=build --chown=node:node /workspace/apps/simulator/package.json /workspace/apps/simulator/package.json
COPY --from=build --chown=node:node /workspace/apps/simulator/dist /workspace/apps/simulator/dist
COPY --from=build --chown=node:node /workspace/apps/console/package.json /workspace/apps/console/package.json
COPY --from=build --chown=node:node /workspace/apps/console/dist /workspace/apps/console/dist

WORKDIR /workspace/apps/console

EXPOSE 3200

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD ["node", "-e", "const port=process.env.PORT||'3200';fetch('http://127.0.0.1:'+port+'/healthz').then((res)=>process.exit(res.ok?0:1)).catch(()=>process.exit(1))"]

USER node

CMD ["node", "dist/index.js"]
