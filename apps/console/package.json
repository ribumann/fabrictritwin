{
  "name": "@triathlon-twin/console",
  "version": "0.1.0",
  "private": true,
  "description": "Demo Control Console - minimal UI to trigger seed-history/trigger-session/trigger-race for the Triathlon Training Twin demo",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/public','dist/public',{recursive:true})\"",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.13.2",
    "@triathlon-twin/simulator": "file:../simulator",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "license": "MIT"
}
