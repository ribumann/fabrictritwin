# Allow only inputs required by the five production Containerfiles.
**
!package.json
!package-lock.json
!tsconfig.base.json
!apps/
!apps/*/
apps/*/*
!apps/*/package.json
!apps/*/tsconfig.json
!apps/*/src/
!apps/*/src/**

# These exclusions must follow the source allowlist.
**/node_modules
**/dist
**/.env*
**/.npmrc
**/.git
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/*.log
