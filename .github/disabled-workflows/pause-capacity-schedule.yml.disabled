# Quarantined: inactive until inputs, identity and deployment targets are reviewed.
name: Pause Fabric Capacity (Scheduled)

on:
  schedule:
    - cron: '0 22 * * *'
  workflow_dispatch:
    inputs:
      resourceGroupName:
        description: Resource group containing the Fabric capacity
        required: false
        default: rg-triathlon-twin-demo
        type: string
      capacityName:
        description: Fabric capacity resource name
        required: false
        default: triatwindevfabriccap
        type: string

permissions:
  id-token: write
  contents: read

jobs:
  pause-capacity:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: azure/login@v2
        with:
          client-id: ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID }}

      - name: Suspend Fabric capacity
        shell: pwsh
        run: |
          ./scripts/fabric/suspend-capacity.ps1 `
            -ResourceGroupName '${{ inputs.resourceGroupName || 'rg-triathlon-twin-demo' }}' `
            -CapacityName '${{ inputs.capacityName || 'triatwindevfabriccap' }}'
