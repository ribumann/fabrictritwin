# Quarantined: inactive until inputs, identity and deployment targets are reviewed.
name: Provision Infrastructure

on:
  workflow_dispatch:
    inputs:
      resourceGroupName:
        description: Resource group to provision into
        required: false
        default: rg-triathlon-twin-demo
        type: string
      location:
        description: Azure region for Container Apps / Key Vault / ACR / Fabric capacity
        required: false
        default: polandcentral
        type: string
      fabricWorkspaceName:
        description: Fabric workspace name to provision/reuse
        required: false
        default: triatwin-dev-workspace
        type: string
      whatIf:
        description: Run in -WhatIf (dry-run) mode -- no resources are changed
        required: false
        default: false
        type: boolean

permissions:
  id-token: write
  contents: read

jobs:
  provision:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: azure/login@v2
        with:
          client-id: ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID }}

      - name: Provision Azure + Fabric infrastructure
        shell: pwsh
        run: |
          $whatIfSwitch = @{}
          if ('${{ inputs.whatIf }}' -eq 'true') { $whatIfSwitch['WhatIf'] = $true }
          ./scripts/provision/provision-all.ps1 `
            -SubscriptionId '${{ secrets.AZURE_SUBSCRIPTION_ID }}' `
            -ResourceGroupName '${{ inputs.resourceGroupName }}' `
            -Location '${{ inputs.location }}' `
            -FabricWorkspaceName '${{ inputs.fabricWorkspaceName }}' `
            @whatIfSwitch
